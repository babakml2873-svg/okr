# PostgreSQL connection string.
# For a pooled provider (Neon, Supabase) use the *pooled* endpoint here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/okr?schema=public"

# Optional. Only needed with a pooled provider: migrations cannot run through
# PgBouncer, so point this at the direct (non-pooled) endpoint. On Neon that is
# the same host without the "-pooler" suffix.
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the app
# Optional. With trustHost enabled the origin is derived from the request,
# so this is only needed behind a proxy that rewrites the host.
# NEXTAUTH_URL="https://okr.example.com"
